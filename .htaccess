# ==============================================================================
# Shakibur Rahaman Portfolio & CMS - Apache / cPanel / LiteSpeed Configuration
# ==============================================================================

DirectoryIndex index.html index.php

RewriteEngine On

# 1. Clean URL Route Rewriting
RewriteRule ^admin/?$ admin.html [L,QSA]
RewriteRule ^services/?$ services.html [L,QSA]

# 2. Route all /api/* requests to Universal PHP API bridge
RewriteRule ^api/(.*)$ api/index.php [L,QSA]
RewriteRule ^api$ api/index.php [L,QSA]

# 3. Block access to backend data store and dot files
RewriteRule ^data(/.*)?$ - [F,L]
RewriteRule ^\.git.*$ - [F,L]

# 4. Correct MIME Types
<IfModule mod_mime.c>
    AddType text/plain .txt
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

# 5. Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 6. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
